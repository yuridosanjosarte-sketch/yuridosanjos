<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Secret Game | Space Invaders</title>
<style>
body {
  margin:0; padding:0;
  background:#000;
  color:#fff;
  font-family:'Courier New', monospace;
  overflow:hidden;
}

canvas {
  display:block;
  margin:0 auto;
  background:#000;
  border: 2px solid #c49b3d;
}

#ui {
  position:fixed;
  top:10px; left:50%;
  transform:translateX(-50%);
  text-align:center;
  font-size:18px;
}

#exitBtn {
  position:fixed;
  top:10px;
  right:20px;
  padding:8px 15px;
  font-size:16px;
  background:rgba(196,155,61,0.9);
  border:none;
  cursor:pointer;
  border-radius:20px;
  color:#000;
  font-weight:bold;
  transition:all 0.3s ease;
}
#exitBtn:hover {
  background:#e0b94f;
}
</style>
</head>
<body>

<canvas id="gameCanvas" width="600" height="800"></canvas>
<div id="ui">Score: <span id="score">0</span></div>
<button id="exitBtn">Exit</button>

<script>
const canvas=document.getElementById('gameCanvas');
const ctx=canvas.getContext('2d');

const player={
  x:canvas.width/2-20,
  y:canvas.height-60,
  width:40,
  height:20,
  speed:5,
  dx:0,
  bullets:[]
};

const invaders=[];
const rows=4;
const cols=8;
const invaderWidth=40;
const invaderHeight=20;
const invaderPadding=20;
let invaderDir=1;
let invaderSpeed=0.7;

let score=0;

// criar inimigos
for(let r=0;r<rows;r++){
  for(let c=0;c<cols;c++){
    invaders.push({
      x:c*(invaderWidth+invaderPadding)+50,
      y:r*(invaderHeight+invaderPadding)+50,
      width:invaderWidth,
      height:invaderHeight,
      alive:true
    });
  }
}

// controles
let keys={};
document.addEventListener('keydown',e=>keys[e.key]=true);
document.addEventListener('keyup',e=>keys[e.key]=false);

// sair do jogo
document.getElementById('exitBtn').addEventListener('click',()=>{window.location.href='../gallery.html'})

// atualizar posição jogador
function movePlayer(){
  if(keys['ArrowLeft'] && player.x>0) player.x-=player.speed;
  if(keys['ArrowRight'] && player.x+player.width<canvas.width) player.x+=player.speed;
}

// atirar
document.addEventListener('keydown',e=>{
  if(e.key===' '){
    player.bullets.push({x:player.x+player.width/2-2.5, y:player.y, width:5, height:10, speed:5});
  }
});

// atualizar balas
function moveBullets(){
  player.bullets.forEach((b,i)=>{
    b.y-=b.speed;
    // colisão com inimigos
    invaders.forEach(inv=>{
      if(inv.alive &&
        b.x<b.x+inv.width && b.x+b.width>inv.x &&
        b.y<b.y+inv.height && b.y+b.height>inv.y){
          inv.alive=false;
          player.bullets.splice(i,1);
          score+=10;
          document.getElementById('score').textContent=score;
      }
    });
    if(b.y<0) player.bullets.splice(i,1);
  });
}

// mover inimigos
function moveInvaders(){
  let edge=false;
  invaders.forEach(inv=>{
    if(inv.alive){
      inv.x+=invaderSpeed*invaderDir;
      if(inv.x+inv.width>canvas.width || inv.x<0) edge=true;
    }
  });
  if(edge){
    invaderDir*=-1;
    invaders.forEach(inv=>inv.y+=10);
  }
}

// desenhar jogador
function drawPlayer(){
  ctx.fillStyle='#c49b3d';
  ctx.fillRect(player.x,player.y,player.width,player.height);
}

// desenhar balas
function drawBullets(){
  ctx.fillStyle='#fff';
  player.bullets.forEach(b=>ctx.fillRect(b.x,b.y,b.width,b.height));
}

// desenhar inimigos
function drawInvaders(){
  ctx.fillStyle='#c49b3d';
  invaders.forEach(inv=>{
    if(inv.alive) ctx.fillRect(inv.x,inv.y,inv.width,inv.height);
  });
}

// desenhar tudo
function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  drawPlayer();
  drawBullets();
  drawInvaders();
}

// loop do jogo
function update(){
  movePlayer();
  moveBullets();
  moveInvaders();
  draw();
  requestAnimationFrame(update);
}

update();
</script>

</body>
</html>
